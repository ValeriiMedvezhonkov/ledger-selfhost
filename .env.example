# --- Database -------------------------------------------------------------
# Neon (production):  postgresql://USER:PASS@ep-xxx.eu-central-1.aws.neon.tech/db?sslmode=require
# Local docker (dev): postgresql://ledger:ledger@localhost:55432/ledger
DATABASE_URL="postgresql://ledger:ledger@localhost:55432/ledger"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated allowlist. Nobody else can sign in, ever.
# `npm run db:seed` uses the first two as the sample household's members.
AUTH_ALLOWED_EMAILS="you@example.com,partner@example.com"

# Display names the seed gives those two, in the same order. Optional — the app
# is the source of truth once it is running, so these only affect a fresh seed.
SEED_MEMBER_A_NAME=""
SEED_MEMBER_B_NAME=""

# Passwords are per account and live hashed in the database, not here.
#   npm run user:password

# --- Cron -----------------------------------------------------------------
# Bearer token for /api/cron/recurring
CRON_SECRET=""

# --- Apple Pay / Wallet webhook -------------------------------------------
# Bearer token for /api/webhooks/wallet, called by an iOS Shortcuts
# "Transaction" automation. Optional: leave empty to disable the endpoint.
# Generate with: openssl rand -hex 24
WALLET_WEBHOOK_SECRET=""

# --- App ------------------------------------------------------------------
APP_BASE_CURRENCY="EUR"

# --- Development ------------------------------------------------------------
# Extra hosts the dev server may serve, comma-separated. Private LAN addresses
# (192.168.*, 10.*, 172.16–31.*) are already allowed, so this is only for a
# host name such as "mylaptop.local". Without it, a page opened from that host
# loads but Server Actions are blocked.
DEV_ORIGINS=""

# --- Releasing (optional) ---------------------------------------------------
# `npm run release` checks this address answers after deploying to Vercel.
PRODUCTION_URL=""
